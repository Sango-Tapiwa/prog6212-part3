<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Contract Monthly Claim System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-primary fixed-top">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-file-invoice-dollar me-2"></i>CMCS
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @if (Context.Session.GetString("UserRole") != null)
                    {
                        <ul class="navbar-nav flex-grow-1">
                            @if (Context.Session.GetString("UserRole") == "Lecturer")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Lecturer" asp-action="Index">
                                        <i class="fas fa-tachometer-alt me-1"></i>Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Lecturer" asp-action="SubmitClaim">
                                        <i class="fas fa-plus me-1"></i>Submit Claim
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Lecturer" asp-action="TrackClaims">
                                        <i class="fas fa-search me-1"></i>Track Claims
                                    </a>
                                </li>
                            }
                            @if (Context.Session.GetString("UserRole") == "Coordinator")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Coordinator" asp-action="Index">
                                        <i class="fas fa-clipboard-check me-1"></i>Pending Claims
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Coordinator" asp-action="AllClaims">
                                        <i class="fas fa-list me-1"></i>All Claims
                                    </a>
                                </li>
                            }
                            @if (Context.Session.GetString("UserRole") == "Manager")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Manager" asp-action="Index">
                                        <i class="fas fa-chart-line me-1"></i>Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Manager" asp-action="PendingClaims">
                                        <i class="fas fa-clock me-1"></i>Pending Claims
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Manager" asp-action="Reports">
                                        <i class="fas fa-chart-bar me-1"></i>Reports
                                    </a>
                                </li>
                            }
                            @if (Context.Session.GetString("UserRole") == "HR")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="HR" asp-action="Index">
                                        <i class="fas fa-users-cog me-1"></i>User Management
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="HR" asp-action="Reports">
                                        <i class="fas fa-file-invoice-dollar me-1"></i>Reports & Invoices
                                    </a>
                                </li>
                            }
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-user me-1"></i>@Context.Session.GetString("UserName")
                                </a>
                                <ul class="dropdown-menu">
                                    <li><h6 class="dropdown-header">@Context.Session.GetString("UserRole")</h6></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Logout">
                                            <i class="fas fa-sign-out-alt me-1"></i>Logout
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="fas fa-sign-in-alt me-1"></i>Login
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid" style="margin-top: 80px;">
        <main role="main" class="pb-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>