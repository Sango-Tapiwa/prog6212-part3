@model IEnumerable<CMCS.Models.Claim>
@{
    ViewData["Title"] = "Manager Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-6">
        <i class="fas fa-chart-line me-2"></i>Manager Dashboard
    </h1>
    <div>
        <a asp-action="PendingClaims" class="btn btn-warning">
            <i class="fas fa-clock me-1"></i>Pending Claims (@ViewBag.PendingClaims)
        </a>
        <a asp-action="Reports" class="btn btn-info">
            <i class="fas fa-chart-bar me-1"></i>View Reports
        </a>
    </div>
</div>

<!-- Statistics Overview -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body text-center">
                <i class="fas fa-file-alt fa-2x mb-2"></i>
                <h4>@ViewBag.TotalClaims</h4>
                <p class="mb-0">Total Claims</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-white">
            <div class="card-body text-center">
                <i class="fas fa-clock fa-2x mb-2"></i>
                <h4>@ViewBag.PendingClaims</h4>
                <p class="mb-0">Pending Review</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body text-center">
                <i class="fas fa-check-circle fa-2x mb-2"></i>
                <h4>@ViewBag.ApprovedClaims</h4>
                <p class="mb-0">Approved</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body text-center">
                <i class="fas fa-dollar-sign fa-2x mb-2"></i>
                <h4>@ViewBag.TotalApprovedAmount.ToString("C")</h4>
                <p class="mb-0">Total Approved</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <!-- Recent Claims -->
        <div class="card">
            <div class="card-header bg-light">
                <h5 class="mb-0">
                    <i class="fas fa-history me-1"></i>Recent Claims Activity
                </h5>
            </div>
            <div class="card-body">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Claim ID</th>
                                    <th>Lecturer</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th>Amount</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var claim in Model.Take(10))
                                {
                                    <tr>
                                        <td><strong>#@claim.ClaimId</strong></td>
                                        <td>@claim.User.FullName</td>
                                        <td>@claim.SubmissionDate.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @switch (claim.Status)
                                            {
                                                case CMCS.Models.ClaimStatus.Submitted:
                                                    <span class="badge bg-info">Submitted</span>
                                                    break;
                                                case CMCS.Models.ClaimStatus.UnderReview:
                                                    <span class="badge bg-warning">Under Review</span>
                                                    break;
                                                case CMCS.Models.ClaimStatus.Approved:
                                                    <span class="badge bg-success">Approved</span>
                                                    break;
                                                case CMCS.Models.ClaimStatus.Rejected:
                                                    <span class="badge bg-danger">Rejected</span>
                                                    break;
                                            }
                                        </td>
                                        <td><strong>@claim.TotalAmount.ToString("C")</strong></td>
                                        <td>
                                            @if (claim.Status == CMCS.Models.ClaimStatus.Submitted || claim.Status == CMCS.Models.ClaimStatus.UnderReview)
                                            {
                                                <a asp-controller="Coordinator" asp-action="ReviewClaim" asp-route-id="@claim.ClaimId"
                                                   class="btn btn-outline-primary btn-sm">
                                                    <i class="fas fa-search me-1"></i>Review
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Completed</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">No claims yet</h5>
                        <p class="text-muted">Claims will appear here as lecturers submit them.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <!-- Quick Stats -->
        <div class="card mb-4">
            <div class="card-header bg-secondary text-white">
                <h6 class="mb-0">
                    <i class="fas fa-tachometer-alt me-1"></i>Quick Overview
                </h6>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-6 border-end">
                        <h4 class="text-danger">@ViewBag.RejectedClaims</h4>
                        <small class="text-muted">Rejected</small>
                    </div>
                    <div class="col-6">
                        <h4 class="text-success">@(ViewBag.ApprovedClaims > 0 ? Math.Round((double)ViewBag.ApprovedClaims / ViewBag.TotalClaims * 100, 1) : 0)%</h4>
                        <small class="text-muted">Approval Rate</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- System Actions -->
        <div class="card">
            <div class="card-header bg-info text-white">
                <h6 class="mb-0">
                    <i class="fas fa-tools me-1"></i>System Actions
                </h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-action="PendingClaims" class="btn btn-warning">
                        <i class="fas fa-clipboard-list me-1"></i>
                        Review Pending Claims (@ViewBag.PendingClaims)
                    </a>
                    <a asp-action="Reports" class="btn btn-info">
                        <i class="fas fa-chart-bar me-1"></i>
                        Generate Reports
                    </a>
                    <a asp-controller="Coordinator" asp-action="AllClaims" class="btn btn-outline-primary">
                        <i class="fas fa-list me-1"></i>
                        View All Claims
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ViewBag.PendingClaims > 5)
{
    <div class="alert alert-warning mt-4">
        <i class="fas fa-exclamation-triangle me-2"></i>
        <strong>Attention:</strong> There are @ViewBag.PendingClaims claims pending review.
        Consider prioritizing claims that have been waiting for more than 7 days.
    </div>
}
