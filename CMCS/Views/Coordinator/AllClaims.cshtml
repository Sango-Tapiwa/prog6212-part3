@model IEnumerable<CMCS.Models.Claim>
@{
    ViewData["Title"] = "All Claims";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-6">
        <i class="fas fa-list me-2"></i>All Claims
    </h1>
    <div>
        <a asp-action="Index" class="btn btn-warning">
            <i class="fas fa-clock me-1"></i>Pending Claims
        </a>
    </div>
</div>

<!-- Statistics Overview -->
<div class="row mb-4">
    <div class="col-md-2">
        <div class="card bg-primary text-white">
            <div class="card-body text-center">
                <i class="fas fa-file-alt fa-2x mb-2"></i>
                <h4>@Model.Count()</h4>
                <p class="mb-0">Total</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-info text-white">
            <div class="card-body text-center">
                <i class="fas fa-paper-plane fa-2x mb-2"></i>
                <h4>@Model.Count(c => c.Status == CMCS.Models.ClaimStatus.Submitted)</h4>
                <p class="mb-0">Submitted</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-warning text-white">
            <div class="card-body text-center">
                <i class="fas fa-eye fa-2x mb-2"></i>
                <h4>@Model.Count(c => c.Status == CMCS.Models.ClaimStatus.UnderReview)</h4>
                <p class="mb-0">Under Review</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-success text-white">
            <div class="card-body text-center">
                <i class="fas fa-check fa-2x mb-2"></i>
                <h4>@Model.Count(c => c.Status == CMCS.Models.ClaimStatus.Approved)</h4>
                <p class="mb-0">Approved</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-danger text-white">
            <div class="card-body text-center">
                <i class="fas fa-times fa-2x mb-2"></i>
                <h4>@Model.Count(c => c.Status == CMCS.Models.ClaimStatus.Rejected)</h4>
                <p class="mb-0">Rejected</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-secondary text-white">
            <div class="card-body text-center">
                <i class="fas fa-dollar-sign fa-2x mb-2"></i>
                <h4>@Model.Sum(c => c.TotalAmount).ToString("C0")</h4>
                <p class="mb-0">Total Value</p>
            </div>
        </div>
    </div>
</div>

<!-- Filter Controls -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-2">
                <select class="form-select" id="statusFilter">
                    <option value="">All Statuses</option>
                    <option value="Submitted">Submitted</option>
                    <option value="UnderReview">Under Review</option>
                    <option value="Approved">Approved</option>
                    <option value="Rejected">Rejected</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="lecturerFilter">
                    <option value="">All Lecturers</option>
                    @foreach (var lecturer in Model.Select(c => c.User).Distinct().OrderBy(u => u.FullName))
                    {
                        <option value="@lecturer.FullName">@lecturer.FullName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" class="form-control" id="dateFrom" placeholder="From Date">
            </div>
            <div class="col-md-2">
                <input type="date" class="form-control" id="dateTo" placeholder="To Date">
            </div>
            <div class="col-md-2">
                <input type="number" class="form-control" id="minAmount" placeholder="Min Amount" step="0.01">
            </div>
            <div class="col-md-2">
                <div class="btn-group w-100">
                    <button class="btn btn-primary" onclick="filterClaims()">
                        <i class="fas fa-filter"></i>
                    </button>
                    <button class="btn btn-outline-secondary" onclick="clearFilters()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Claims Table -->
<div class="card">
    <div class="card-header bg-light">
        <h5 class="mb-0">
            <i class="fas fa-table me-1"></i>Claims Overview
        </h5>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover" id="claimsTable">
                    <thead class="table-dark">
                        <tr>
                            <th>Claim ID</th>
                            <th>Lecturer</th>
                            <th>Submission Date</th>
                            <th>Status</th>
                            <th>Items</th>
                            <th>Total Amount</th>
                            <th>Processing Time</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in Model.OrderByDescending(c => c.SubmissionDate))
                        {
                            var processingDays = claim.ApprovedDate.HasValue
                            ? (claim.ApprovedDate.Value - claim.SubmissionDate).Days
                            : (DateTime.Now - claim.SubmissionDate).Days;

                            <tr data-status="@claim.Status"
                                data-lecturer="@claim.User.FullName"
                                data-date="@claim.SubmissionDate.ToString("yyyy-MM-dd")"
                                data-amount="@claim.TotalAmount">
                                <td><strong>#@claim.ClaimId</strong></td>
                                <td>@claim.User.FullName</td>
                                <td>@claim.SubmissionDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @switch (claim.Status)
                                    {
                                        case CMCS.Models.ClaimStatus.Submitted:
                                            <span class="badge bg-info">
                                                <i class="fas fa-paper-plane me-1"></i>Submitted
                                            </span>
                                            break;
                                        case CMCS.Models.ClaimStatus.UnderReview:
                                            <span class="badge bg-warning">
                                                <i class="fas fa-eye me-1"></i>Under Review
                                            </span>
                                            break;
                                        case CMCS.Models.ClaimStatus.Approved:
                                            <span class="badge bg-success">
                                                <i class="fas fa-check me-1"></i>Approved
                                            </span>
                                            break;
                                        case CMCS.Models.ClaimStatus.Rejected:
                                            <span class="badge bg-danger">
                                                <i class="fas fa-times me-1"></i>Rejected
                                            </span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@claim.ClaimItems.Count items</span>
                                </td>
                                <td><strong>@claim.TotalAmount.ToString("C")</strong></td>
                                <td>
                                    @if (claim.Status == CMCS.Models.ClaimStatus.Submitted || claim.Status == CMCS.Models.ClaimStatus.UnderReview)
                                    {
                                        if (processingDays > 14)
                                        {
                                            <span class="badge bg-danger">@processingDays days</span>
                                        }
                                        else if (processingDays > 7)
                                        {
                                            <span class="badge bg-warning">@processingDays days</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">@processingDays days</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-success">@processingDays days</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="ReviewClaim" asp-route-id="@claim.ClaimId"
                                           class="btn btn-outline-primary btn-sm">
                                            <i class="fas fa-search me-1"></i>View
                                        </a>
                                        @if (claim.Status == CMCS.Models.ClaimStatus.Submitted || claim.Status == CMCS.Models.ClaimStatus.UnderReview)
                                        {
                                            <button type="button" class="btn btn-outline-success btn-sm"
                                                    onclick="showApproveModal(@claim.ClaimId, '@claim.User.FullName', '@claim.TotalAmount.ToString("C")')">
                                                <i class="fas fa-check"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger btn-sm"
                                                    onclick="showRejectModal(@claim.ClaimId, '@claim.User.FullName', '@claim.TotalAmount.ToString("C")')">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">No claims found</h5>
                <p class="text-muted">No claims have been submitted yet.</p>
            </div>
        }
    </div>
</div>

<!-- Approve Modal -->
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">
                    <i class="fas fa-check-circle me-1"></i>Approve Claim
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ApproveClaim" method="post">
                <div class="modal-body">
                    <input type="hidden" name="id" id="approveClaimId" />
                    <p>Are you sure you want to approve this claim?</p>
                    <div class="alert alert-info">
                        <strong>Lecturer:</strong> <span id="approveLecturerName"></span><br>
                        <strong>Amount:</strong> <span id="approveAmount"></span>
                    </div>
                    <div class="mb-3">
                        <label for="approveComments" class="form-label">Approval Comments (Optional)</label>
                        <textarea name="comments" id="approveComments" class="form-control" rows="3"
                                  placeholder="Add any comments about this approval..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-check me-1"></i>Approve Claim
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="fas fa-times-circle me-1"></i>Reject Claim
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="RejectClaim" method="post">
                <div class="modal-body">
                    <input type="hidden" name="id" id="rejectClaimId" />
                    <p>Are you sure you want to reject this claim?</p>
                    <div class="alert alert-warning">
                        <strong>Lecturer:</strong> <span id="rejectLecturerName"></span><br>
                        <strong>Amount:</strong> <span id="rejectAmount"></span>
                    </div>
                    <div class="mb-3">
                        <label for="rejectComments" class="form-label">Rejection Reason <span class="text-danger">*</span></label>
                        <textarea name="comments" id="rejectComments" class="form-control" rows="3" required
                                  placeholder="Please provide a reason for rejecting this claim..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-times me-1"></i>Reject Claim
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterClaims() {
            const statusFilter = document.getElementById('statusFilter').value;
            const lecturerFilter = document.getElementById('lecturerFilter').value;
            const dateFrom = document.getElementById('dateFrom').value;
            const dateTo = document.getElementById('dateTo').value;
            const minAmount = parseFloat(document.getElementById('minAmount').value) || 0;
            const rows = document.querySelectorAll('#claimsTable tbody tr');

            rows.forEach(row => {
                let showRow = true;

                // Status filter
                if (statusFilter && !row.dataset.status.includes(statusFilter)) {
                    showRow = false;
                }

                // Lecturer filter
                if (lecturerFilter && row.dataset.lecturer !== lecturerFilter) {
                    showRow = false;
                }

                // Date range filter
                const rowDate = row.dataset.date;
                if (dateFrom && rowDate < dateFrom) {
                    showRow = false;
                }
                if (dateTo && rowDate > dateTo) {
                    showRow = false;
                }

                // Amount filter
                const rowAmount = parseFloat(row.dataset.amount);
                if (minAmount > 0 && rowAmount < minAmount) {
                    showRow = false;
                }

                row.style.display = showRow ? '' : 'none';
            });
        }

        function clearFilters() {
            document.getElementById('statusFilter').value = '';
            document.getElementById('lecturerFilter').value = '';
            document.getElementById('dateFrom').value = '';
            document.getElementById('dateTo').value = '';
            document.getElementById('minAmount').value = '';

            const rows = document.querySelectorAll('#claimsTable tbody tr');
            rows.forEach(row => {
                row.style.display = '';
            });
        }

        function showApproveModal(claimId, lecturerName, amount) {
            document.getElementById('approveClaimId').value = claimId;
            document.getElementById('approveLecturerName').textContent = lecturerName;
            document.getElementById('approveAmount').textContent = amount;
            new bootstrap.Modal(document.getElementById('approveModal')).show();
        }

        function showRejectModal(claimId, lecturerName, amount) {
            document.getElementById('rejectClaimId').value = claimId;
            document.getElementById('rejectLecturerName').textContent = lecturerName;
            document.getElementById('rejectAmount').textContent = amount;
            new bootstrap.Modal(document.getElementById('rejectModal')).show();
        }
    </script>
}