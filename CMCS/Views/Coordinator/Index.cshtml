@model IEnumerable<CMCS.Models.Claim>
@{
    ViewData["Title"] = "Coordinator Dashboard - Pending Claims";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-6">
        <i class="fas fa-clipboard-check me-2"></i>Pending Claims for Review
    </h1>
    <div>
        <a asp-action="AllClaims" class="btn btn-outline-primary">
            <i class="fas fa-list me-1"></i>View All Claims
        </a>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card bg-warning text-white">
            <div class="card-body text-center">
                <i class="fas fa-clock fa-2x mb-2"></i>
                <h4>@Model.Count()</h4>
                <p class="mb-0">Pending Review</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card bg-info text-white">
            <div class="card-body text-center">
                <i class="fas fa-dollar-sign fa-2x mb-2"></i>
                <h4>@Model.Sum(c => c.TotalAmount).ToString("C")</h4>
                <p class="mb-0">Total Value</p>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-light">
        <h5 class="mb-0">
            <i class="fas fa-exclamation-triangle me-1 text-warning"></i>Claims Awaiting Review
        </h5>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Claim ID</th>
                            <th>Lecturer</th>
                            <th>Submission Date</th>
                            <th>Status</th>
                            <th>Items</th>
                            <th>Total Amount</th>
                            <th>Days Pending</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in Model.OrderBy(c => c.SubmissionDate))
                        {
                            var daysPending = (DateTime.Now - claim.SubmissionDate).Days;
                            <tr class="@(daysPending > 7 ? "table-warning" : "")">
                                <td><strong>#@claim.ClaimId</strong></td>
                                <td>@claim.User.FullName</td>
                                <td>@claim.SubmissionDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @switch (claim.Status)
                                    {
                                        case CMCS.Models.ClaimStatus.Submitted:
                                            <span class="badge bg-info">
                                                <i class="fas fa-paper-plane me-1"></i>Submitted
                                            </span>
                                            break;
                                        case CMCS.Models.ClaimStatus.UnderReview:
                                            <span class="badge bg-warning">
                                                <i class="fas fa-eye me-1"></i>Under Review
                                            </span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@claim.ClaimItems.Count items</span>
                                </td>
                                <td><strong>@claim.TotalAmount.ToString("C")</strong></td>
                                <td>
                                    @if (daysPending > 7)
                                    {
                                        <span class="badge bg-danger">@daysPending days</span>
                                    }
                                    else if (daysPending > 3)
                                    {
                                        <span class="badge bg-warning">@daysPending days</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@daysPending days</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="ReviewClaim" asp-route-id="@claim.ClaimId"
                                           class="btn btn-outline-primary btn-sm">
                                            <i class="fas fa-search me-1"></i>Review
                                        </a>
                                        <button type="button" class="btn btn-outline-success btn-sm"
                                                onclick="showApproveModal(@claim.ClaimId, '@claim.User.FullName', '@claim.TotalAmount.ToString("C")')">
                                            <i class="fas fa-check me-1"></i>Approve
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm"
                                                onclick="showRejectModal(@claim.ClaimId, '@claim.User.FullName', '@claim.TotalAmount.ToString("C")')">
                                            <i class="fas fa-times me-1"></i>Reject
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                <h5 class="text-muted">No pending claims</h5>
                <p class="text-muted">All claims have been processed!</p>
            </div>
        }
    </div>
</div>

<!-- Approve Modal -->
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">
                    <i class="fas fa-check-circle me-1"></i>Approve Claim
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ApproveClaim" method="post">
                <div class="modal-body">
                    <input type="hidden" name="id" id="approveClaimId" />
                    <p>Are you sure you want to approve this claim?</p>
                    <div class="alert alert-info">
                        <strong>Lecturer:</strong> <span id="approveLecturerName"></span><br>
                        <strong>Amount:</strong> <span id="approveAmount"></span>
                    </div>
                    <div class="mb-3">
                        <label for="approveComments" class="form-label">Approval Comments (Optional)</label>
                        <textarea name="comments" id="approveComments" class="form-control" rows="3"
                                  placeholder="Add any comments about this approval..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-check me-1"></i>Approve Claim
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="fas fa-times-circle me-1"></i>Reject Claim
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="RejectClaim" method="post">
                <div class="modal-body">
                    <input type="hidden" name="id" id="rejectClaimId" />
                    <p>Are you sure you want to reject this claim?</p>
                    <div class="alert alert-warning">
                        <strong>Lecturer:</strong> <span id="rejectLecturerName"></span><br>
                        <strong>Amount:</strong> <span id="rejectAmount"></span>
                    </div>
                    <div class="mb-3">
                        <label for="rejectComments" class="form-label">Rejection Reason <span class="text-danger">*</span></label>
                        <textarea name="comments" id="rejectComments" class="form-control" rows="3" required
                                  placeholder="Please provide a reason for rejecting this claim..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-times me-1"></i>Reject Claim
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showApproveModal(claimId, lecturerName, amount) {
            document.getElementById('approveClaimId').value = claimId;
            document.getElementById('approveLecturerName').textContent = lecturerName;
            document.getElementById('approveAmount').textContent = amount;
            new bootstrap.Modal(document.getElementById('approveModal')).show();
        }

        function showRejectModal(claimId, lecturerName, amount) {
            document.getElementById('rejectClaimId').value = claimId;
            document.getElementById('rejectLecturerName').textContent = lecturerName;
            document.getElementById('rejectAmount').textContent = amount;
            new bootstrap.Modal(document.getElementById('rejectModal')).show();
        }
    </script>
}