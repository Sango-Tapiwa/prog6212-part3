@model IEnumerable<CMCS.Models.Claim>
@{
    ViewData["Title"] = "HR Reports & Invoices";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-6">
        <i class="fas fa-file-invoice-dollar me-2"></i>HR Reports & Invoices
    </h1>
    <div>
        <button class="btn btn-success" onclick="generatePDF()">
            <i class="fas fa-file-pdf me-1"></i>Generate PDF Report
        </button>
        <button class="btn btn-info" onclick="exportToCSV()">
            <i class="fas fa-file-csv me-1"></i>Export to CSV
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to Users
        </a>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body text-center">
                <i class="fas fa-file-alt fa-2x mb-2"></i>
                <h4>@Model.Count()</h4>
                <p class="mb-0">Total Claims</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body text-center">
                <i class="fas fa-check-circle fa-2x mb-2"></i>
                <h4>@Model.Count(c => c.Status == CMCS.Models.ClaimStatus.Approved)</h4>
                <p class="mb-0">Approved Claims</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body text-center">
                <i class="fas fa-dollar-sign fa-2x mb-2"></i>
                <h4>@Model.Where(c => c.Status == CMCS.Models.ClaimStatus.Approved).Sum(c => c.TotalAmount).ToString("C0")</h4>
                <p class="mb-0">Total Paid</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-white">
            <div class="card-body text-center">
                <i class="fas fa-clock fa-2x mb-2"></i>
                <h4>@Model.Count(c => c.Status == CMCS.Models.ClaimStatus.Submitted || c.Status == CMCS.Models.ClaimStatus.UnderReview)</h4>
                <p class="mb-0">Pending</p>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-secondary text-white">
        <h5 class="mb-0">
            <i class="fas fa-filter me-1"></i>Filter Options
        </h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select class="form-select" id="statusFilter">
                    <option value="">All Statuses</option>
                    <option value="Submitted">Submitted</option>
                    <option value="UnderReview">Under Review</option>
                    <option value="Approved">Approved</option>
                    <option value="Rejected">Rejected</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Lecturer</label>
                <select class="form-select" id="lecturerFilter">
                    <option value="">All Lecturers</option>
                    @foreach (var lecturer in Model.Select(c => c.User).Distinct().OrderBy(u => u.FullName))
                    {
                        <option value="@lecturer.FullName">@lecturer.FullName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">From Date</label>
                <input type="date" class="form-control" id="dateFrom">
            </div>
            <div class="col-md-2">
                <label class="form-label">To Date</label>
                <input type="date" class="form-control" id="dateTo">
            </div>
            <div class="col-md-2">
                <label class="form-label">&nbsp;</label>
                <div class="d-grid gap-2">
                    <button class="btn btn-primary" onclick="filterClaims()">
                        <i class="fas fa-filter"></i> Filter
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-light">
        <h5 class="mb-0">
            <i class="fas fa-table me-1"></i>Detailed Claims Report
        </h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover" id="claimsTable">
                <thead class="table-dark">
                    <tr>
                        <th>Claim ID</th>
                        <th>Lecturer</th>
                        <th>Submission Date</th>
                        <th>Status</th>
                        <th>Hours Worked</th>
                        <th>Hourly Rate</th>
                        <th>Total Amount</th>
                        <th>Approved Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var claim in Model.OrderByDescending(c => c.SubmissionDate))
                    {
                        <tr data-status="@claim.Status"
                            data-lecturer="@claim.User.FullName"
                            data-date="@claim.SubmissionDate.ToString("yyyy-MM-dd")">
                            <td><strong>#@claim.ClaimId</strong></td>
                            <td>@claim.User.FullName</td>
                            <td>@claim.SubmissionDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @switch (claim.Status)
                                {
                                    case CMCS.Models.ClaimStatus.Submitted:
                                        <span class="badge bg-info">Submitted</span>
                                        break;
                                    case CMCS.Models.ClaimStatus.UnderReview:
                                        <span class="badge bg-warning">Under Review</span>
                                        break;
                                    case CMCS.Models.ClaimStatus.Approved:
                                        <span class="badge bg-success">Approved</span>
                                        break;
                                    case CMCS.Models.ClaimStatus.Rejected:
                                        <span class="badge bg-danger">Rejected</span>
                                        break;
                                }
                            </td>
                            <td>@claim.ClaimItems.Sum(i => i.HoursWorked) hrs</td>
                            <td>@claim.User.HourlyRate.ToString("C")</td>
                            <td><strong>@claim.TotalAmount.ToString("C")</strong></td>
                            <td>
                                @if (claim.ApprovedDate.HasValue)
                                {
                                    @claim.ApprovedDate.Value.ToString("dd/MM/yyyy")
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-dark">
                    <tr>
                        <td colspan="4"><strong>Totals</strong></td>
                        <td><strong>@Model.SelectMany(c => c.ClaimItems).Sum(i => i.HoursWorked) hrs</strong></td>
                        <td></td>
                        <td><strong>@Model.Sum(c => c.TotalAmount).ToString("C")</strong></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0">
            <i class="fas fa-users me-1"></i>Lecturer Summary Report
        </h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Lecturer</th>
                        <th>Hourly Rate</th>
                        <th>Total Claims</th>
                        <th>Approved Claims</th>
                        <th>Total Hours</th>
                        <th>Total Amount Paid</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lecturerGroup in Model.GroupBy(c => c.User).OrderBy(g => g.Key.FullName))
                    {
                        var lecturer = lecturerGroup.Key;
                        var claims = lecturerGroup.ToList();
                        var approvedClaims = claims.Where(c => c.Status == CMCS.Models.ClaimStatus.Approved).ToList();

                        <tr>
                            <td><strong>@lecturer.FullName</strong></td>
                            <td>@lecturer.HourlyRate.ToString("C")</td>
                            <td>@claims.Count</td>
                            <td><span class="badge bg-success">@approvedClaims.Count</span></td>
                            <td>@approvedClaims.SelectMany(c => c.ClaimItems).Sum(i => i.HoursWorked) hrs</td>
                            <td><strong>@approvedClaims.Sum(c => c.TotalAmount).ToString("C")</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
    <script>
        function filterClaims() {
            const statusFilter = document.getElementById('statusFilter').value;
            const lecturerFilter = document.getElementById('lecturerFilter').value;
            const dateFrom = document.getElementById('dateFrom').value;
            const dateTo = document.getElementById('dateTo').value;
            const rows = document.querySelectorAll('#claimsTable tbody tr');

            rows.forEach(row => {
                let showRow = true;

                if (statusFilter && !row.dataset.status.includes(statusFilter)) {
                    showRow = false;
                }

                if (lecturerFilter && row.dataset.lecturer !== lecturerFilter) {
                    showRow = false;
                }

                const rowDate = row.dataset.date;
                if (dateFrom && rowDate < dateFrom) {
                    showRow = false;
                }
                if (dateTo && rowDate > dateTo) {
                    showRow = false;
                }

                row.style.display = showRow ? '' : 'none';
            });
        }

        function exportToCSV() {
            const table = document.getElementById('claimsTable');
            const rows = Array.from(table.querySelectorAll('tr:not([style*="display: none"])'));

            const csvContent = rows.map(row => {
                const cells = Array.from(row.querySelectorAll('th, td'));
                return cells.map(cell => {
                    let content = cell.textContent.trim();
                    content = content.replace(/\s+/g, ' ');
                    if (content.includes(',') || content.includes('"')) {
                        content = '"' + content.replace(/"/g, '""') + '"';
                    }
                    return content;
                }).join(',');
            }).join('\n');

            const blob = new Blob([csvContent], { type: 'text/csv' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `claims-report-${new Date().toISOString().split('T')[0]}.csv`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            window.URL.revokeObjectURL(url);
        }

        function generatePDF() {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();

            doc.setFontSize(18);
            doc.text('Claims Report', 14, 22);

            doc.setFontSize(11);
            doc.text(`Generated: ${new Date().toLocaleDateString()}`, 14, 30);

            const table = document.getElementById('claimsTable');
            const rows = Array.from(table.querySelectorAll('tbody tr:not([style*="display: none"])'));

            const tableData = rows.map(row => {
                const cells = Array.from(row.querySelectorAll('td'));
                return cells.map(cell => cell.textContent.trim());
            });

            doc.autoTable({
                startY: 35,
                head: [['Claim ID', 'Lecturer', 'Date', 'Status', 'Hours', 'Rate', 'Amount', 'Approved']],
                body: tableData,
                theme: 'striped',
                headStyles: { fillColor: [52, 58, 64] },
                margin: { top: 35 }
            });

            doc.save(`claims-report-${new Date().toISOString().split('T')[0]}.pdf`);
        }
    </script>
}
