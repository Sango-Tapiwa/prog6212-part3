@model IEnumerable<CMCS.Models.User>
@{
    ViewData["Title"] = "HR Dashboard - User Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-6">
        <i class="fas fa-users-cog me-2"></i>User Management
    </h1>
    <div>
        <a asp-action="CreateUser" class="btn btn-success">
            <i class="fas fa-user-plus me-1"></i>Add New User
        </a>
        <a asp-action="Reports" class="btn btn-info">
            <i class="fas fa-chart-bar me-1"></i>Reports & Invoices
        </a>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body text-center">
                <i class="fas fa-users fa-2x mb-2"></i>
                <h4>@Model.Count()</h4>
                <p class="mb-0">Total Users</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body text-center">
                <i class="fas fa-chalkboard-teacher fa-2x mb-2"></i>
                <h4>@Model.Count(u => u.Role == CMCS.Models.RoleType.Lecturer)</h4>
                <p class="mb-0">Lecturers</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body text-center">
                <i class="fas fa-user-check fa-2x mb-2"></i>
                <h4>@Model.Count(u => u.IsActive)</h4>
                <p class="mb-0">Active Users</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-white">
            <div class="card-body text-center">
                <i class="fas fa-user-times fa-2x mb-2"></i>
                <h4>@Model.Count(u => !u.IsActive)</h4>
                <p class="mb-0">Inactive Users</p>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-light">
        <h5 class="mb-0">
            <i class="fas fa-list me-1"></i>All Users
        </h5>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Hourly Rate</th>
                            <th>Status</th>
                            <th>Total Claims</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr class="@(!user.IsActive ? "table-secondary" : "")">
                                <td>
                                    <strong>@user.FullName</strong>
                                    @if (!user.IsActive)
                                    {
                                        <span class="badge bg-secondary ms-1">Inactive</span>
                                    }
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    @switch (user.Role)
                                    {
                                        case CMCS.Models.RoleType.Lecturer:
                                            <span class="badge bg-success">
                                                <i class="fas fa-chalkboard-teacher me-1"></i>Lecturer
                                            </span>
                                            break;
                                        case CMCS.Models.RoleType.Coordinator:
                                            <span class="badge bg-primary">
                                                <i class="fas fa-clipboard-check me-1"></i>Coordinator
                                            </span>
                                            break;
                                        case CMCS.Models.RoleType.Manager:
                                            <span class="badge bg-warning">
                                                <i class="fas fa-user-tie me-1"></i>Manager
                                            </span>
                                            break;
                                        case CMCS.Models.RoleType.HR:
                                            <span class="badge bg-danger">
                                                <i class="fas fa-users-cog me-1"></i>HR
                                            </span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (user.Role == CMCS.Models.RoleType.Lecturer)
                                    {
                                        <strong>@user.HourlyRate.ToString("C")</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    @if (user.Role == CMCS.Models.RoleType.Lecturer)
                                    {
                                        <span class="badge bg-info">@user.Claims.Count claims</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="EditUser" asp-route-id="@user.UserId" class="btn btn-outline-primary btn-sm">
                                            <i class="fas fa-edit me-1"></i>Edit
                                        </a>
                                        @if (user.IsActive && user.Role != CMCS.Models.RoleType.HR)
                                        {
                                            <button type="button" class="btn btn-outline-danger btn-sm"
                                                    onclick="confirmDeactivate(@user.UserId, '@user.FullName')">
                                                <i class="fas fa-user-times me-1"></i>Deactivate
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-users fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">No users found</h5>
                <p class="text-muted">Start by adding users to the system.</p>
                <a asp-action="CreateUser" class="btn btn-primary">
                    <i class="fas fa-user-plus me-1"></i>Add First User
                </a>
            </div>
        }
    </div>
</div>

<form id="deactivateForm" method="post" asp-action="DeleteUser" style="display: none;">
    <input type="hidden" name="id" id="deactivateUserId" />
</form>

@section Scripts {
    <script>
        function confirmDeactivate(userId, userName) {
            if (confirm(`Are you sure you want to deactivate ${userName}?`)) {
                document.getElementById('deactivateUserId').value = userId;
                document.getElementById('deactivateForm').submit();
            }
        }
    </script>
}
